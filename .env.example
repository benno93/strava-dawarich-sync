# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Your Dawarich instance (no trailing slash) and the API key from its account settings
DAWARICH_URL=https://dawarich.example.com
DAWARICH_API_KEY=

# all = every activity with GPS. To limit, list Strava sport types: Run,TrailRun,Ride
SPORT_TYPES=all

# true = skip Zwift, ROUVY & co. (virtual sport types and indoor trainer activities)
SKIP_VIRTUAL=true

# How often to check for new activities
SYNC_INTERVAL_MINUTES=60

# Days to look back on each run, for activities a watch uploads late
LOOKBACK_DAYS=14

# true = only write GPX files to ./data/gpx, upload nothing (for testing)
DRY_RUN=false
